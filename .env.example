PORT=3000
NODE_ENV=development
# Use your managed PostgreSQL provider's pooled connection string in DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Optional: PGSSL=require (default for production); set PGSSL=disable only for local non-TLS PostgreSQL.
PGSSL=require
PG_POOL_MAX=5
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@vsscommunity.org
# Generate a bcrypt hash for your chosen password and place it here.
# node -e "require('bcryptjs').hash('YOUR_STRONG_PASSWORD',12).then(console.log)"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
